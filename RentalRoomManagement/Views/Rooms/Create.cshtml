@model RentalRoomManagement.Models.Room

@{
    ViewData["Title"] = "Thêm phòng";
}

<div class="container mt-4">

    <h2>Thêm phòng</h2>

    <hr />

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Mã phòng -->
        <div class="mb-3">
            <label asp-for="RoomCode" class="form-label">
                Mã phòng
            </label>

            <input asp-for="RoomCode"
                   class="form-control"
                   placeholder="Ví dụ: P101" />

            <span asp-validation-for="RoomCode"
                  class="text-danger">
            </span>
        </div>

        <!-- Mô tả -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Mô tả
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="3"
                      placeholder="Nhập mô tả phòng">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>
        </div>

        <!-- Thể loại -->
        <div class="mb-3">
            <label asp-for="RoomType" class="form-label">
                Thể loại phòng
            </label>

            <select asp-for="RoomType"
                    class="form-select">

                <option value="">-- Chọn thể loại --</option>

                <option value="Phòng đơn">
                    Phòng đơn
                </option>

                <option value="Phòng đôi">
                    Phòng đôi
                </option>

                <option value="Phòng VIP">
                    Phòng VIP
                </option>

            </select>

            <span asp-validation-for="RoomType"
                  class="text-danger">
            </span>
        </div>

        <!-- Giá -->
        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Giá thuê
            </label>

            <input asp-for="Price"
                   type="number"
                   class="form-control"
                   min="0"
                   placeholder="Ví dụ: 200000" />

            <span asp-validation-for="Price"
                  class="text-danger">
            </span>
        </div>

        <!-- Nút -->
        <div class="mt-4">

            <button type="submit"
                    class="btn btn-primary">
                Thêm phòng
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

    </form>

</div>